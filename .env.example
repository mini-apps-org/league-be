
APP_ENV=
PORT=

# debug | info | warn | error, case-insensitive. Overrides logger.level in the
# embedded per-environment YAML; leave empty to use it. A value that will not
# parse logs a warning and falls back to info rather than stopping the process.
LOG_LEVEL=

DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public API origin.
BASE_URL=
# Redirect target after login and the only allowed CORS origin.
FRONTEND_URL=

# Absolute session lifetime, and the idle window reset on each authenticated
# request. A session dies at whichever comes first. Defaults: 12h / 30m.
SESSION_TTL=
SESSION_IDLE_TTL=

# Seals the oauth_tx cookie (and stored API keys in M2).
# Exactly 32 bytes: openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

